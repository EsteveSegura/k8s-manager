{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.js"
  },
  "mutate": [
    "src/lib/**/*.ts",
    "src/composables/**/*.ts",
    "src/stores/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/lib/download.ts",
    "!src/composables/useTheme.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "html",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "clearTextReporter": {
    "allowColor": false,
    "logTests": false
  },
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 92
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
